# Versiones fijadas de la ISO. Cualquier cambio aquí es una versión nueva de la ISO.

DEBIAN_SUITE=trixie
# Fecha de snapshot.debian.org para builds reproducibles (vacía = deb.debian.org,
# para desarrollo). Formato: AAAAMMDDTHHMMSSZ.
DEBIAN_SNAPSHOT=

# Compilados por nosotros: Debian 13 trae partclone 0.3.36 (con el fallo de
# BLOCK_GROUP_TREE, partclone#303) y btrfs-progs 6.14.
PARTCLONE_VERSION=0.3.50
BTRFS_PROGS_VERSION=6.19.1
# Sufijo de versión Debian de nuestros paquetes (sube con cada recompilación).
DEB_REVISION=0partshield1
