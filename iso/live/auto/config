#!/bin/sh
# Configuración de live-build de la ISO de PartShield (Debian 13 trixie).
# Lo ejecuta `lb config`; las réplicas llegan por el entorno desde build-iso.sh.
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "$PS_MIRROR" \
    --mirror-chroot "$PS_MIRROR" \
    --mirror-chroot-security "$PS_MIRROR_SECURITY" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-binary-security "http://security.debian.org/debian-security/" \
    --security true \
    --updates true \
    --apt-recommends false \
    --apt-options "--yes -o Acquire::Check-Valid-Until=false -o Acquire::Retries=5" \
    --linux-flavours amd64 \
    --firmware-chroot false \
    --binary-images iso-hybrid \
    --bootloaders "grub-efi,syslinux" \
    --uefi-secure-boot enable \
    --debian-installer none \
    --memtest none \
    --iso-application "PartShield" \
    --iso-publisher "PartShield; https://partshield.io" \
    --iso-volume "PARTSHIELD" \
    --bootappend-live "boot=live components username=partshield hostname=partshield locales=es_ES.UTF-8 keyboard-layouts=es console=tty0 console=ttyS0,115200n8" \
    --cache-packages true \
    "${@}"
