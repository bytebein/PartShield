[Unit]
Description=PartShield: anunciar arranque completo
# Sin After=multi-user.target: multi-user.target ya espera a esta unidad
# (WantedBy) y ordenarla detrás crearía un ciclo.
After=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/lib/partshield/ready.sh
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
